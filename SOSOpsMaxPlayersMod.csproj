<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- 1. Check user-defined property or environment variable -->
    <GameDir Condition="'$(GameDir)' == '' and '$(SOSOPS_PATH)' != ''">$(SOSOPS_PATH)</GameDir>

    <!-- 2. Auto-detect from Steam Registry (HKCU) -->
    <_SteamPathFromRegistry Condition="'$(GameDir)' == '' and '$(OS)' == 'Windows_NT'">$([MSBuild]::GetRegistryValueFromView('HKEY_CURRENT_USER\Software\Valve\Steam', 'SteamPath', null, RegistryView.Default))</_SteamPathFromRegistry>
    <GameDir Condition="'$(GameDir)' == '' and '$(_SteamPathFromRegistry)' != '' and Exists('$(_SteamPathFromRegistry)\steamapps\common\SOS OPS')">$(_SteamPathFromRegistry)\steamapps\common\SOS OPS</GameDir>

    <!-- 3. Fallback to common Steam library locations -->
    <GameDir Condition="'$(GameDir)' == '' and Exists('C:\Program Files (x86)\Steam\steamapps\common\SOS OPS')">C:\Program Files (x86)\Steam\steamapps\common\SOS OPS</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and Exists('C:\Program Files\Steam\steamapps\common\SOS OPS')">C:\Program Files\Steam\steamapps\common\SOS OPS</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and Exists('D:\SteamLibrary\steamapps\common\SOS OPS')">D:\SteamLibrary\steamapps\common\SOS OPS</GameDir>
    <GameDir Condition="'$(GameDir)' == '' and Exists('E:\SteamLibrary\steamapps\common\SOS OPS')">E:\SteamLibrary\steamapps\common\SOS OPS</GameDir>
  </PropertyGroup>

  <!-- Friendly error message if GameDir cannot be located -->
  <Target Name="ValidateGameDir" BeforeTargets="BeforeBuild">
    <Message Importance="high" Text="Using detected SOS OPS GameDir: '$(GameDir)'" />
    <Error Condition="'$(GameDir)' == '' or !Exists('$(GameDir)')"
           Text="Could not automatically detect the SOS OPS game directory. Please pass -p:GameDir=&quot;path/to/SOS OPS&quot; or set the SOSOPS_PATH environment variable." />
  </Target>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(GameDir)\MelonLoader\net6\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\MelonLoader\net6\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(GameDir)\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSOSOPS.Constants">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSOSOPS.Constants.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSOSOPS.Game">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSOSOPS.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSOSOPS.Utility">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppSOSOPS.Utility.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppFacepunch.Steamworks.Win64">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Il2CppFacepunch.Steamworks.Win64.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Netcode.Runtime">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\Unity.Netcode.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Automatically copy the compiled mod to the game's Mods directory after building -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent" Condition="Exists('$(GameDir)\Mods')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods" ContinueOnError="true" />
  </Target>

</Project>
